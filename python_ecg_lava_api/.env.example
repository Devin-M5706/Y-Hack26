LAVA_API_KEY=your_lava_api_key_here
LAVA_CHAT_COMPLETIONS_URL=https://api.lava.so/v1/chat/completions
LAVA_MODEL_NAME=gemini-3.1-pro-preview
STEMI_CONFIDENCE_THRESHOLD=0.80
ENFORCE_STEMI_CONFIDENCE_THRESHOLD=false
DEFAULT_TARGET_DEVICE_ID=iphone-device-1
DEFAULT_TARGET_DEVICE_IDS=

# API authentication — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ERAC_API_KEY=

# CORS origins (comma-separated, default "*" for dev)
CORS_ORIGINS=*

# Server binding (default 127.0.0.1:8000)
HOST=127.0.0.1
PORT=8000
